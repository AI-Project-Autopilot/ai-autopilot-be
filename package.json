{
  "name": "ai-autopilot-be",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node --files --require tsconfig-paths/register src/main.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:db": "npm run build && RUN_DB_TESTS=1 node --test test/*.db.test.cjs",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Project-Autopilot/ai-autopilot-be.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AI-Project-Autopilot/ai-autopilot-be/issues"
  },
  "homepage": "https://github.com/AI-Project-Autopilot/ai-autopilot-be#readme",
  "description": "Backend service for AI Project Autopilot.",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/lint-staged": "^13.3.0",
    "@types/node": "^24.1.0",
    "@types/passport": "^1.0.17",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "^6.12.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
