generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutopilotUser {
  id        String               @id @default(cuid())
  githubId  String               @unique
  login     String
  name      String?
  avatarUrl String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  sessions  AutopilotSession[]
  analyses  RepositoryAnalysis[]
  tasks     TrackedTask[]
}

model AutopilotSession {
  tokenHash            String        @id
  userId               String
  user                 AutopilotUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubTokenEncrypted String
  expiresAt            DateTime
  createdAt            DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AutopilotOAuthState {
  stateHash         String   @id
  browserHash       String
  verifierEncrypted String
  expiresAt         DateTime

  @@index([expiresAt])
}

enum RepositoryAnalysisStatus {
  running
  succeeded
  failed
  cancelled
}

model RepositoryAnalysis {
  id            String                   @id @default(cuid())
  userId        String
  user          AutopilotUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId  String
  goal          String                   @db.VarChar(2000)
  status        RepositoryAnalysisStatus @default(running)
  fullName      String?
  defaultBranch String?
  htmlUrl       String?
  commitSha     String?
  isPrivate     Boolean?
  model         String
  summary       String?
  result        Json?
  context       Json?
  errorCode     String?
  createdAt     DateTime                 @default(now())
  startedAt     DateTime                 @default(now())
  completedAt   DateTime?
  updatedAt     DateTime                 @updatedAt
  tasks         TrackedTask[]

  @@index([userId, createdAt, id])
  @@index([userId, repositoryId, createdAt, id])
}

enum TrackedTaskStatus {
  selected
  in_progress
  completed
  cancelled
}

enum IssueCreationState {
  none
  creating
  created
  uncertain
}

model TrackedTask {
  id                     String             @id @default(cuid())
  userId                 String
  user                   AutopilotUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId             String
  analysis               RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  recommendationId       String
  repositoryId           String
  fullName               String
  language               String             @db.VarChar(2)
  title                  String             @db.VarChar(200)
  body                   String             @db.Text
  priority               String
  source                 Json
  status                 TrackedTaskStatus  @default(selected)
  issueNumber            Int?
  issueUrl               String?
  issueState             String?
  issueStateReason       String?
  issueCreationState     IssueCreationState @default(none)
  issueCreationStartedAt DateTime?
  issueSyncedAt          DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([userId, analysisId, recommendationId])
  @@unique([userId, repositoryId, issueNumber])
  @@index([userId, createdAt, id])
  @@index([userId, repositoryId, createdAt, id])
}
